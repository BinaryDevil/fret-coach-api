generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Handedness {
  RIGHT
  LEFT
}
enum ExerciseType {
  CHROMATIC
  SCALE
  FINGER_DEXTERITY
}
enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
enum FeedbackCategory {
  PITCH
  RHYTHM
  TECHNIQUE
  BEND
  OTHER
}
enum FeedbackSeverity {
  INFO
  WARNING
  ERROR
}
enum ScoreFormat {
  GUITAR_PRO
  MUSIC_XML
  ALPHA_TEX
}
enum PracticeAttemptStatus {
  COMPLETED
  ABANDONED
}
enum PracticeNoteOutcome {
  CORRECT
  WRONG_PITCH
  MISSING
  EXTRA_NOTE
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  googleSubject String? @unique
  displayName String?
  handedness Handedness @default(RIGHT)
  tuning String @default("E2,A2,D3,G3,B3,E4")
  timezone String @default("UTC")
  refreshTokenHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions PracticeSession[]
  progress UserProgress?
  practiceAttempts PracticeAttempt[]
  exerciseProgress UserExerciseProgress[]
}

model Exercise {
  id String @id @default(cuid())
  slug String @unique
  type ExerciseType
  difficulty Difficulty @default(BEGINNER)
  title String
  description String?
  instructions String?
  skillFocus String @default("Technique fundamentals")
  estimatedMinutes Int @default(8)
  libraryOrder Int @default(0)
  configuration Json
  referenceAudioUrl String?
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions PracticeSession[]
  score ExerciseScore?
  loopRegions LoopRegion[]
  practiceAttempts PracticeAttempt[]
  userExerciseProgress UserExerciseProgress[]
  @@index([type, difficulty, isPublished])
}

model ExerciseScore {
  id String @id @default(cuid())
  exerciseId String @unique
  format ScoreFormat
  fileName String?
  storageKey String?
  content String?
  timeSignature String @default("4/4")
  defaultBpm Int
  totalMeasures Int
  backingTrackUrl String?
  backingTrackOffsetMs Int @default(0)
  eventVersion Int @default(0)
  eventSourceHash String?
  timeline Json?
  eventGenerationError String?
  eventGeneratedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model LoopRegion {
  id String @id @default(cuid())
  exerciseId String
  title String
  startMeasure Int
  endMeasure Int
  defaultBpm Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessions PracticeSession[]
  practiceAttempts PracticeAttempt[]
  @@unique([exerciseId, startMeasure, endMeasure])
  @@index([exerciseId, startMeasure])
}

model PracticeSession {
  id String @id @default(cuid())
  userId String
  exerciseId String?
  pieceTitle String?
  sheetMusicUrl String?
  backingTrackUrl String?
  loopRegionId String?
  targetBpm Int?
  durationSeconds Int?
  status SessionStatus @default(IN_PROGRESS)
  startedAt DateTime @default(now())
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  loopRegion LoopRegion? @relation(fields: [loopRegionId], references: [id], onDelete: SetNull)
  recordings PerformanceRecording[]
  @@index([userId, startedAt])
  @@index([exerciseId])
  @@index([loopRegionId])
}

model PracticeAttempt {
  id String @id @default(uuid())
  clientRunId String @unique
  userId String
  exerciseId String
  loopRegionId String?
  scoreRevision String
  status PracticeAttemptStatus @default(COMPLETED)
  bpm Int
  countInBeats Int
  activeDurationMs Int
  totalTargetEvents Int
  correctCount Int
  wrongPitchCount Int
  missingCount Int
  extraNoteCount Int @default(0)
  accuracyPercent Int
  startedAt DateTime?
  completedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  loopRegion LoopRegion? @relation(fields: [loopRegionId], references: [id], onDelete: SetNull)
  noteResults PracticeNoteResult[]
  @@index([userId, completedAt])
  @@index([userId, exerciseId, completedAt])
}

model PracticeNoteResult {
  id String @id @default(uuid())
  attemptId String
  timelineEventId String
  eventIndex Int
  measure Int
  beat Int
  startTick Int
  expectedPitches Int[]
  outcome PracticeNoteOutcome
  detectedMidi Int?
  correctedMidi Int?
  centsOffset Int?
  octaveShift Int?
  confidence Float?
  timingOffsetMs Int?
  createdAt DateTime @default(now())
  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@unique([attemptId, timelineEventId])
  @@index([attemptId, eventIndex])
}

model UserExerciseProgress {
  id String @id @default(uuid())
  userId String
  exerciseId String
  completedPasses Int @default(0)
  totalActiveMs Int @default(0)
  bestAccuracyPercent Int @default(0)
  bestBpm Int @default(0)
  latestAccuracyPercent Int?
  lastPracticedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@unique([userId, exerciseId])
  @@index([userId, lastPracticedAt])
}

model PerformanceRecording {
  id String @id @default(cuid())
  sessionId String
  storageKey String @unique
  mimeType String
  durationMs Int?
  recordedAt DateTime @default(now())
  createdAt DateTime @default(now())
  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  analysis PerformanceAnalysis?
  @@index([sessionId, recordedAt])
}

model PerformanceAnalysis {
  id String @id @default(cuid())
  recordingId String @unique
  status AnalysisStatus @default(QUEUED)
  modelVersion String?
  overallScore Float?
  pitchScore Float?
  rhythmScore Float?
  techniqueScore Float?
  summary String?
  errorMessage String?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recording PerformanceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  feedback PerformanceFeedback[]
  @@index([status, createdAt])
}

model PerformanceFeedback {
  id String @id @default(cuid())
  analysisId String
  category FeedbackCategory
  severity FeedbackSeverity
  startMs Int?
  endMs Int?
  message String
  suggestion String?
  metadata Json?
  createdAt DateTime @default(now())
  analysis PerformanceAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@index([analysisId, startMs])
}

model UserProgress {
  id String @id @default(cuid())
  userId String @unique
  totalSessions Int @default(0)
  totalPracticeSeconds Int @default(0)
  currentDayStreak Int @default(0)
  longestDayStreak Int @default(0)
  lastPracticedOn DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
